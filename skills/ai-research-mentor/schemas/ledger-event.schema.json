{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-research-mentor:ledger-event:1",
  "title": "Python ledger-json-v1 event envelope",
  "description": "Editor assistance for one JSONL event. Runtime Ledger.verify checks roles, chain and sequence; ResearchCore.verify_artifacts replays provider and anchor observations. Passing this schema never authenticates provenance or a human.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "id", "ts", "type", "actor", "trust", "data", "prev", "protocol", "sha256"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "pattern": "^EV-[0-9]{6,}$"},
    "ts": {"type": "string", "format": "date-time"},
    "type": {"type": "string", "enum": [
      "project.init", "search.result", "project.update", "paper.resolve", "source.fetch",
      "evidence.anchor", "source.identity.confirm", "candidate.upsert", "claim.add",
      "claim.link", "review.record", "decision.record", "decision.revoke", "reading.confirm"
    ]},
    "actor": {"enum": ["tool", "user", "model"]},
    "trust": {"enum": ["T0", "T1", "T2", "TL"]},
    "data": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
    "prev": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "protocol": {"const": "ledger-json-v1"},
    "sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"oneOf": [
      {"properties": {"actor": {"const": "tool"}, "trust": {"enum": ["T0", "TL"]}}},
      {"properties": {"actor": {"const": "user"}, "trust": {"const": "T1"}}},
      {"properties": {"actor": {"const": "model"}, "trust": {"const": "T2"}}}
    ]},
    {"if": {"properties": {"type": {"enum": ["project.init", "search.result", "paper.resolve", "source.fetch", "evidence.anchor"]}}}, "then": {"properties": {"actor": {"const": "tool"}, "trust": {"const": "T0"}}}},
    {"if": {"properties": {"type": {"enum": ["project.update", "source.identity.confirm", "decision.record", "decision.revoke"]}}}, "then": {"properties": {"actor": {"const": "user"}, "trust": {"const": "T1"}}}},
    {"if": {"properties": {"type": {"enum": ["candidate.upsert", "claim.add", "claim.link", "review.record"]}}}, "then": {"properties": {"actor": {"const": "model"}, "trust": {"const": "T2"}}}},
    {"if": {"properties": {"type": {"const": "reading.confirm"}}}, "then": {"properties": {"actor": {"enum": ["model", "user"]}, "trust": {"enum": ["T1", "T2"]}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "value": {"oneOf": [
      {"type": ["string", "integer", "boolean", "null"]},
      {"type": "array", "items": {"$ref": "#/$defs/value"}},
      {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}}
    ]}
  }
}
