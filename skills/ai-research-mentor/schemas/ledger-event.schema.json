{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-research-mentor:ledger-event:1",
  "title": "Python ledger-json-v1 event envelope",
  "description": "Editor assistance for one JSONL event. Runtime Ledger.verify checks roles, chain and sequence; ResearchCore.verify_artifacts replays provider and anchor observations. Passing this schema never authenticates provenance or a human.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "id", "ts", "type", "actor", "trust", "data", "prev", "protocol", "sha256"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "pattern": "^EV-[0-9]{6,}$"},
    "ts": {"type": "string", "format": "date-time"},
    "type": {"type": "string", "enum": [
      "project.init", "search.result", "project.update", "paper.resolve", "source.fetch",
      "evidence.anchor", "source.identity.confirm", "candidate.upsert", "claim.add",
      "claim.link", "review.record", "decision.record", "decision.revoke", "reading.confirm",
      "result.record", "result.invalidate", "reading.retract"
    ]},
    "actor": {"enum": ["tool", "user", "model"]},
    "trust": {"enum": ["T0", "T1", "T2", "TL"]},
    "data": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
    "prev": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "protocol": {"const": "ledger-json-v1"},
    "sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"oneOf": [
      {"properties": {"actor": {"const": "tool"}, "trust": {"enum": ["T0", "TL"]}}},
      {"properties": {"actor": {"const": "user"}, "trust": {"const": "T1"}}},
      {"properties": {"actor": {"const": "model"}, "trust": {"const": "T2"}}}
    ]},
    {"if": {"properties": {"type": {"enum": ["project.init", "search.result", "paper.resolve", "source.fetch", "evidence.anchor"]}}}, "then": {"properties": {"actor": {"const": "tool"}, "trust": {"const": "T0"}}}},
    {"if": {"properties": {"type": {"enum": ["project.update", "source.identity.confirm", "decision.record", "decision.revoke"]}}}, "then": {"properties": {"actor": {"const": "user"}, "trust": {"const": "T1"}}}},
    {"if": {"properties": {"type": {"enum": ["candidate.upsert", "claim.add", "claim.link", "review.record"]}}}, "then": {"properties": {"actor": {"const": "model"}, "trust": {"const": "T2"}}}},
    {"if": {"properties": {"type": {"const": "reading.confirm"}}}, "then": {"properties": {"actor": {"enum": ["model", "user"]}, "trust": {"enum": ["T1", "T2"]}}}},
    {"if": {"properties": {"type": {"const": "reading.retract"}}}, "then": {"properties": {"actor": {"enum": ["model", "user"]}, "trust": {"enum": ["T1", "T2"]}, "data": {"$ref": "#/$defs/readingRetraction"}}}},
    {"if": {"properties": {"type": {"const": "result.record"}}}, "then": {"properties": {"actor": {"enum": ["model", "user"]}, "trust": {"enum": ["T1", "T2"]}, "data": {"$ref": "#/$defs/resultRecord"}}}},
    {"if": {"properties": {"type": {"const": "result.invalidate"}}}, "then": {"properties": {"actor": {"const": "user"}, "trust": {"const": "T1"}, "data": {"$ref": "#/$defs/resultInvalidation"}}}}
  ],
  "$defs": {
    "nonempty": {"type": "string", "pattern": "\\S"},
    "readingRetraction": {
      "type": "object", "additionalProperties": false, "required": ["target", "reason"],
      "properties": {"target": {"$ref": "#/$defs/nonempty"}, "reason": {"$ref": "#/$defs/nonempty"}}
    },
    "resultRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "run_id", "candidate_id", "candidate_version", "kind", "outcome", "artifacts", "summary", "limitations", "affected_claims"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"}, "run_id": {"$ref": "#/$defs/nonempty"},
        "candidate_id": {"$ref": "#/$defs/nonempty"}, "candidate_version": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["smoke", "scientific"]},
        "outcome": {"enum": ["not_run", "execution_failed", "inconclusive", "supported", "contradicted"]},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
        "summary": {"$ref": "#/$defs/nonempty"},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
        "affected_claims": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["claim_id", "reason"],
          "properties": {"claim_id": {"$ref": "#/$defs/nonempty"}, "reason": {"$ref": "#/$defs/nonempty"}}
        }},
        "supersedes": {"$ref": "#/$defs/nonempty"}, "reason": {"$ref": "#/$defs/nonempty"}
      },
      "allOf": [
        {"if": {"required": ["supersedes"]}, "then": {"required": ["reason"]}, "else": {"not": {"required": ["reason"]}}},
        {"if": {"properties": {"outcome": {"const": "not_run"}}}, "else": {"properties": {"artifacts": {"minItems": 1}}}}
      ]
    },
    "resultInvalidation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "run_id", "candidate_id", "candidate_version", "result_id", "reason", "recorded_at"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"}, "run_id": {"$ref": "#/$defs/nonempty"},
        "candidate_id": {"$ref": "#/$defs/nonempty"}, "candidate_version": {"type": "integer", "minimum": 1},
        "result_id": {"$ref": "#/$defs/nonempty"}, "reason": {"$ref": "#/$defs/nonempty"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "value": {"oneOf": [
      {"type": ["string", "integer", "boolean", "null"]},
      {"type": "array", "items": {"$ref": "#/$defs/value"}},
      {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}}
    ]}
  }
}
